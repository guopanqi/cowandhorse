  "routeDesign": {
    "firstRing": {
      "west": "格子间与打印区：较慢、低掩体多、组长覆盖频繁。",
      "crosscut": "服务核心南侧横切：短，但容易同时进入组长与经理视线。",
      "east": "协作区与茶水区：更开放，依赖经理日程窗口。"
    },
    "secondRing": {
      "west": "绕老板办公室：最远、硬遮挡多，但老板出门时风险暴涨。",
      "center": "老板办公室与会议室之间：最短、遮挡最少。",
      "east": "绕玻璃会议室：较长，可以用拐角切断追逐。"
    }
  },
